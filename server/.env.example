PORT=5000
CLIENT_URL=http://localhost:5173

# Maximum download size per file. Increase for legitimate large 1080p/4K content;
# decrease to restrict disk usage. Default: 2048 (2 GB).
MAX_FILE_SIZE_MB=2048
MAX_DOWNLOAD_TIME_SECONDS=300

RATE_LIMIT_ANALYZE=30
RATE_LIMIT_DOWNLOAD=20
RATE_LIMIT_BULK=5
RATE_LIMIT_WINDOW_MINUTES=1

TEMP_FILE_TTL_MINUTES=15
TEMP_DIR=/tmp/media-downloader

# RapidAPI YouTube service
YOUTUBE_API_HOST=youtube138.p.rapidapi.com
YOUTUBE_API_KEY=your_rapidapi_key_here
